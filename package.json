{
  "name": "roosevelt",
  "description": "🧸 MVC web framework for Node.js designed to make Express easier to use.",
  "author": "Roosevelt Framework Team <rooseveltframework@gmail.com>",
  "contributors": [
    {
      "name": "Contributors",
      "url": "https://github.com/rooseveltframework/roosevelt/graphs/contributors"
    }
  ],
  "version": "0.33.2",
  "files": [
    "*.md",
    "config.js",
    "defaultErrorPages",
    "lib",
    "roosevelt.js"
  ],
  "homepage": "https://rooseveltframework.org/docs/latest/get-started/",
  "license": "CC-BY-4.0",
  "main": "roosevelt.js",
  "bin": {
    "roosevelt-generate-certs": "lib/scripts/certsGenerator.js",
    "roosevelt-generate-secrets": "lib/scripts/secretsGenerator.js",
    "roosevelt-generate-session-secret": "lib/scripts/sessionSecretGenerator.js",
    "roosevelt-migrate-config": "lib/scripts/migrateConfig.js"
  },
  "readmeFilename": "README.md",
  "engines": {
    "node": ">=22.20.0"
  },
  "dependencies": {
    "@colors/colors": "1.6.0",
    "@nodelib/fs.walk": "3.0.1",
    "app-module-path": "2.2.0",
    "better-sqlite3": "13.0.3",
    "clean-css": "5.3.3",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "csrf-sync": "4.2.1",
    "express-browser-reload": "4.0.0",
    "express-html-validator": "1.0.1",
    "express-session": "1.19.0",
    "formidable": "3.5.4",
    "fs-extra": "11.4.0",
    "helmet": "8.3.0",
    "html-minifier-terser": "7.2.0",
    "method-override": "3.0.0",
    "minify-html-attributes": "1.0.2",
    "morgan": "1.11.0",
    "progressively-enhance-web-components": "1.0.4",
    "roosevelt-logger": "1.0.1",
    "selfsigned": "5.5.0",
    "serve-favicon": "2.5.1",
    "source-configs": "1.0.2"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@rspack/core": "2.2.0",
    "axios": "1.20.0",
    "c8": "12.0.0",
    "ejs": "6.0.1",
    "esbuild": "0.28.2",
    "express": "5.2.1",
    "less": "4.9.0",
    "node-forge": "1.4.0",
    "prompts": "2.4.2",
    "proxyquire": "2.1.3",
    "pug": "3.0.4",
    "rollup": "4.63.1",
    "sass": "1.103.1",
    "sinon": "22.1.0",
    "standard": "17.1.2",
    "stylus": "0.64.0",
    "supertest": "7.2.2",
    "teddy": "1.2.0",
    "watcher": "2.3.1",
    "webpack": "5.109.2"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/rooseveltframework/roosevelt.git"
  },
  "keywords": [
    "roosevelt.js",
    "teddy.js",
    "node.js",
    "roosevelt",
    "teddy",
    "mvc",
    "Express",
    "Express.js",
    "framework",
    "web framework"
  ],
  "preferGlobal": true,
  "_from": "roosevelt@*",
  "gitHead": "",
  "scripts": {
    "coverage": "c8 --reporter=text --reporter=lcov node --import ./test/util/testSetup.js --test --test-reporter=spec --test-timeout=60000 \"test/*.js\"",
    "lint": "standard",
    "lint-fix": "standard --fix",
    "migrate-config": "node lib/scripts/migrateConfig.js",
    "test": "node --import ./test/util/testSetup.js --test --test-reporter=spec --test-timeout=60000 \"test/*.js\"",
    "test-debug": "node --inspect-brk --import ./test/util/testSetup.js --test --test-reporter=spec --test-concurrency=1 --test-timeout=0 \"test/*.js\"",
    "test-package": "node lib/scripts/packageSmokeTest.js"
  },
  "funding": "https://www.paypal.com/donate/?hosted_button_id=2L2X8GRXZCGJ6"
}
